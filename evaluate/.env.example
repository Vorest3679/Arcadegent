# 复制为 evaluate/.env；也可执行 python -m evaluate init-env。
# 此文件只被评测读取，不加载项目根 .env，不会修改生产配置。
EVAL_MODELS=default
EVAL_LLM_API_KEY=
EVAL_LLM_BASE_URL=
EVAL_LLM_MODEL=
EVAL_LLM_API_MODE=chat_completions
EVAL_LLM_AUTH_HEADER=Authorization
EVAL_LLM_SEND_TEMPERATURE=true
EVAL_LLM_TEMPERATURE=0.2
EVAL_LLM_TOKEN_PARAMETER=max_tokens
EVAL_LLM_EXTRA_PARAMETERS={}

# 先跑 3 个合成 smoke case。真实 benchmark 必须同时修改：
# EVAL_CASES=datasets/public/benchmark.yaml
# EVAL_DATA=../data/local/arcades.geocoded.sample.jsonl
# 所有相对路径均以 evaluate/ 为基准。
EVAL_CASES=datasets/public/smoke.yaml
EVAL_DATA=fixtures/arcades/synthetic.jsonl
EVAL_REPEAT=1
EVAL_MAX_REQUESTS=40
EVAL_MAX_CALLS_PER_ATTEMPT=40
EVAL_MAX_TOOL_CALLS=40
EVAL_MAX_OUTPUT_TOKENS=1024
EVAL_REQUEST_TIMEOUT_S=45
EVAL_ATTEMPT_TIMEOUT_S=300
EVAL_REQUEST_INTERVAL_S=1

# 在线质量判分：开启后必须填写独立 judge 配置。费用和 token 单独统计。
EVAL_JUDGE_ENABLED=false
EVAL_JUDGE_API_KEY=
EVAL_JUDGE_BASE_URL=
EVAL_JUDGE_MODEL=
EVAL_JUDGE_API_MODE=chat_completions
EVAL_JUDGE_MAX_REQUESTS=20
EVAL_QUALITY_THRESHOLD=75

# 默认地图服务禁用。导航 case 需显式打开并填写高德 Web 服务 key。
EVAL_MAP_MODE=disabled
EVAL_AMAP_API_KEY=

# 多模型可设置 EVAL_MODELS=deepseek,glm,kimi,mimo（或其中任意子集）。
# 每个模型填写账号实际支持的 ID 和 endpoint；不假定同名代理能力相同。
EVAL_DEEPSEEK_API_KEY=
EVAL_DEEPSEEK_BASE_URL=
EVAL_DEEPSEEK_MODEL=
EVAL_DEEPSEEK_API_MODE=chat_completions
EVAL_LUNA_API_KEY=
EVAL_LUNA_BASE_URL=
EVAL_LUNA_MODEL=
EVAL_LUNA_API_MODE=responses
EVAL_GLM_API_KEY=
EVAL_GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
EVAL_GLM_MODEL=glm-5.3-flash
EVAL_GLM_API_MODE=chat_completions
EVAL_GLM_AUTH_HEADER=Authorization
EVAL_GLM_SEND_TEMPERATURE=true
EVAL_GLM_TOKEN_PARAMETER=max_tokens
EVAL_GLM_EXTRA_PARAMETERS={}
EVAL_KIMI_API_KEY=
EVAL_KIMI_BASE_URL=
EVAL_KIMI_MODEL=
EVAL_KIMI_API_MODE=chat_completions
EVAL_MIMO_API_KEY=
EVAL_MIMO_BASE_URL=
EVAL_MIMO_MODEL=
EVAL_MIMO_API_MODE=chat_completions
EVAL_MIMO_AUTH_HEADER=api-key
EVAL_MIMO_TOKEN_PARAMETER=max_completion_tokens

# 可选：每百万 token 单价（自行填同一币种下的最新价格）。缺失则费用为 null。
# 每个 profile 可用同样的后缀，例如 EVAL_KIMI_INPUT_PRICE。
# cached/reasoning 是子集；reasoning 已计入 output，不额外相加。
EVAL_DEEPSEEK_INPUT_PRICE=
EVAL_DEEPSEEK_CACHED_INPUT_PRICE=
EVAL_DEEPSEEK_OUTPUT_PRICE=
EVAL_LUNA_INPUT_PRICE=
EVAL_LUNA_CACHED_INPUT_PRICE=
EVAL_LUNA_OUTPUT_PRICE=
EVAL_GLM_INPUT_PRICE=
EVAL_GLM_CACHED_INPUT_PRICE=
EVAL_GLM_OUTPUT_PRICE=
EVAL_KIMI_INPUT_PRICE=
EVAL_KIMI_CACHED_INPUT_PRICE=
EVAL_KIMI_OUTPUT_PRICE=
EVAL_MIMO_INPUT_PRICE=
EVAL_MIMO_CACHED_INPUT_PRICE=
EVAL_MIMO_OUTPUT_PRICE=
EVAL_LLM_INPUT_PRICE=
EVAL_LLM_CACHED_INPUT_PRICE=
EVAL_LLM_OUTPUT_PRICE=
EVAL_CURRENCY=CNY
